(version 1)
# SAF-1 (requirements.yaml): RLY1 contact island >= 3.0 mm to every other net
(rule "SAF-1 RLY1 contact island 3.0 mm" (condition "(A.NetClass == 'relay1') && !(B.NetClass == 'relay1')") (constraint clearance (min 3.0mm)))
# SAF-1 (requirements.yaml): RLY2 contact island >= 3.0 mm to every other net
(rule "SAF-1 RLY2 contact island 3.0 mm" (condition "(A.NetClass == 'relay2') && !(B.NetClass == 'relay2')") (constraint clearance (min 3.0mm)))
(rule "plane_spokes" (constraint min_resolved_spokes 1))
(rule "H1_internal_holes" (condition "A.memberOfFootprint('H1') && B.memberOfFootprint('H1')") (constraint hole_clearance (min 0.15mm)))
(rule "H2_internal_holes" (condition "A.memberOfFootprint('H2') && B.memberOfFootprint('H2')") (constraint hole_clearance (min 0.15mm)))
(rule "H3_internal_holes" (condition "A.memberOfFootprint('H3') && B.memberOfFootprint('H3')") (constraint hole_clearance (min 0.15mm)))
(rule "H4_internal_holes" (condition "A.memberOfFootprint('H4') && B.memberOfFootprint('H4')") (constraint hole_clearance (min 0.15mm)))
(rule "J_DKN_internal_holes" (condition "A.memberOfFootprint('J_DKN') && B.memberOfFootprint('J_DKN')") (constraint hole_clearance (min 0.15mm)))
(rule "J_DKS_internal_holes" (condition "A.memberOfFootprint('J_DKS') && B.memberOfFootprint('J_DKS')") (constraint hole_clearance (min 0.15mm)))
(rule "J_PIN_internal_holes" (condition "A.memberOfFootprint('J_PIN') && B.memberOfFootprint('J_PIN')") (constraint hole_clearance (min 0.15mm)))
(rule "J_PIS_internal_holes" (condition "A.memberOfFootprint('J_PIS') && B.memberOfFootprint('J_PIS')") (constraint hole_clearance (min 0.15mm)))
(rule "J_PWR_internal_holes" (condition "A.memberOfFootprint('J_PWR') && B.memberOfFootprint('J_PWR')") (constraint hole_clearance (min 0.15mm)))
(rule "J_IN_internal_holes" (condition "A.memberOfFootprint('J_IN') && B.memberOfFootprint('J_IN')") (constraint hole_clearance (min 0.15mm)))
(rule "J_O1_internal_holes" (condition "A.memberOfFootprint('J_O1') && B.memberOfFootprint('J_O1')") (constraint hole_clearance (min 0.15mm)))
(rule "J_O2_internal_holes" (condition "A.memberOfFootprint('J_O2') && B.memberOfFootprint('J_O2')") (constraint hole_clearance (min 0.15mm)))
(rule "J_O3_internal_holes" (condition "A.memberOfFootprint('J_O3') && B.memberOfFootprint('J_O3')") (constraint hole_clearance (min 0.15mm)))
(rule "J_O4_internal_holes" (condition "A.memberOfFootprint('J_O4') && B.memberOfFootprint('J_O4')") (constraint hole_clearance (min 0.15mm)))
(rule "J_R1_internal_holes" (condition "A.memberOfFootprint('J_R1') && B.memberOfFootprint('J_R1')") (constraint hole_clearance (min 0.15mm)))
(rule "K1_internal_holes" (condition "A.memberOfFootprint('K1') && B.memberOfFootprint('K1')") (constraint hole_clearance (min 0.15mm)))
(rule "J_R2_internal_holes" (condition "A.memberOfFootprint('J_R2') && B.memberOfFootprint('J_R2')") (constraint hole_clearance (min 0.15mm)))
(rule "K2_internal_holes" (condition "A.memberOfFootprint('K2') && B.memberOfFootprint('K2')") (constraint hole_clearance (min 0.15mm)))
(rule "J_T1_internal_holes" (condition "A.memberOfFootprint('J_T1') && B.memberOfFootprint('J_T1')") (constraint hole_clearance (min 0.15mm)))
(rule "J_T2_internal_holes" (condition "A.memberOfFootprint('J_T2') && B.memberOfFootprint('J_T2')") (constraint hole_clearance (min 0.15mm)))
