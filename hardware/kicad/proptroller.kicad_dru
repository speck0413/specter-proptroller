(rule "J_PX_internal_holes" (condition "A.memberOfFootprint('J_PX') && B.memberOfFootprint('J_PX')") (constraint hole_clearance (min 0.15mm)))
(rule "J_DFA_internal_holes" (condition "A.memberOfFootprint('J_DFA') && B.memberOfFootprint('J_DFA')") (constraint hole_clearance (min 0.15mm)))
(rule "J_DFB_internal_holes" (condition "A.memberOfFootprint('J_DFB') && B.memberOfFootprint('J_DFB')") (constraint hole_clearance (min 0.15mm)))
(rule "J_SPK_internal_holes" (condition "A.memberOfFootprint('J_SPK') && B.memberOfFootprint('J_SPK')") (constraint hole_clearance (min 0.15mm)))
(rule "J_LO_internal_holes" (condition "A.memberOfFootprint('J_LO') && B.memberOfFootprint('J_LO')") (constraint hole_clearance (min 0.15mm)))
(rule "J_XS_internal_holes" (condition "A.memberOfFootprint('J_XS') && B.memberOfFootprint('J_XS')") (constraint hole_clearance (min 0.15mm)))
