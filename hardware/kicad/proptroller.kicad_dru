(rule "J_RAIL_internal_holes" (condition "A.memberOfFootprint('J_RAIL') && B.memberOfFootprint('J_RAIL')") (constraint hole_clearance (min 0.15mm)))
(rule "keepout_H1 head" (condition "A.intersectsArea('H1 head')") (constraint disallow track via zone))
(rule "keepout_H4 head" (condition "A.intersectsArea('H4 head')") (constraint disallow track via zone))
(rule "keepout_Pico W antenna" (condition "A.intersectsArea('Pico W antenna')") (constraint disallow track via zone))
(rule "keepout_SAF-1 RLY1 pour pullback" (condition "A.intersectsArea('SAF-1 RLY1 pour pullback')") (constraint disallow zone))
(rule "keepout_SAF-1 RLY1 COM pour pullback F" (condition "A.intersectsArea('SAF-1 RLY1 COM pour pullback F')") (constraint disallow zone))
(rule "keepout_SAF-1 RLY1 COM pour pullback B" (condition "A.intersectsArea('SAF-1 RLY1 COM pour pullback B')") (constraint disallow zone))
(rule "keepout_SAF-1 RLY1 COM moat N" (condition "A.intersectsArea('SAF-1 RLY1 COM moat N')") (constraint disallow track via zone))
(rule "keepout_SAF-1 RLY1 COM moat W" (condition "A.intersectsArea('SAF-1 RLY1 COM moat W')") (constraint disallow track via zone))
(rule "keepout_SAF-1 RLY1 COM moat E" (condition "A.intersectsArea('SAF-1 RLY1 COM moat E')") (constraint disallow track via zone))
(rule "keepout_SAF-1 RLY1 inside W" (condition "A.intersectsArea('SAF-1 RLY1 inside W')") (constraint disallow track via))
(rule "keepout_SAF-1 RLY1 inside E" (condition "A.intersectsArea('SAF-1 RLY1 inside E')") (constraint disallow track via))
(rule "keepout_SAF-1 RLY2 pour pullback" (condition "A.intersectsArea('SAF-1 RLY2 pour pullback')") (constraint disallow zone))
(rule "keepout_SAF-1 RLY2 COM pour pullback F" (condition "A.intersectsArea('SAF-1 RLY2 COM pour pullback F')") (constraint disallow zone))
(rule "keepout_SAF-1 RLY2 COM pour pullback B" (condition "A.intersectsArea('SAF-1 RLY2 COM pour pullback B')") (constraint disallow zone))
(rule "keepout_SAF-1 RLY2 COM moat N" (condition "A.intersectsArea('SAF-1 RLY2 COM moat N')") (constraint disallow track via zone))
(rule "keepout_SAF-1 RLY2 COM moat W" (condition "A.intersectsArea('SAF-1 RLY2 COM moat W')") (constraint disallow track via zone))
(rule "keepout_SAF-1 RLY2 COM moat E" (condition "A.intersectsArea('SAF-1 RLY2 COM moat E')") (constraint disallow track via zone))
(rule "keepout_SAF-1 RLY2 inside W" (condition "A.intersectsArea('SAF-1 RLY2 inside W')") (constraint disallow track via))
(rule "keepout_SAF-1 RLY2 inside E" (condition "A.intersectsArea('SAF-1 RLY2 inside E')") (constraint disallow track via))
(rule "keepout_SAF-1 RLY1 moat W" (condition "A.intersectsArea('SAF-1 RLY1 moat W')") (constraint disallow track via))
(rule "keepout_SAF-1 RLY1-RLY2 moat" (condition "A.intersectsArea('SAF-1 RLY1-RLY2 moat')") (constraint disallow track via))
(rule "keepout_SAF-1 RLY2 moat E" (condition "A.intersectsArea('SAF-1 RLY2 moat E')") (constraint disallow track via))
(rule "keepout_SAF-1 relay terminals moat S" (condition "A.intersectsArea('SAF-1 relay terminals moat S')") (constraint disallow track via))
