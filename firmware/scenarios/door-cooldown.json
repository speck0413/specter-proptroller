{
  "name": "Door: trigger, timeline, cooldown, a held trigger never restarts it",
  "shows": [{
    "id": 1, "name": "Door", "cooldown_ms": 4000,
    "triggers": [{"on": "input", "input": "TRIG1"}],
    "tracks": [
      {"target": "OUT1", "cues": [{"at": 0, "do": "on"}, {"at": 1500, "do": "off"}]},
      {"target": "RLY1", "cues": [{"at": 500, "do": "on"}, {"at": 1000, "do": "off"}]},
      {"target": "SOUND", "cues": [{"at": 0, "do": "play", "folder": 1, "track": 3}]}
    ]
  }],
  "steps": [
    {"at": 2000, "do": "press", "input": "TRIG1", "ms": 150},
    {"at": 2150, "do": "expect", "levels": {"OUT1": 1000, "RLY1": 0}},
    {"at": 2800, "do": "expect", "levels": {"OUT1": 1000, "RLY1": 1000}},
    {"at": 2900, "do": "expect_sound", "playing": true},
    {"at": 3700, "do": "expect", "levels": {"OUT1": 0, "RLY1": 0}},
    {"at": 4000, "do": "press", "input": "TRIG1", "ms": 150},
    {"at": 4200, "do": "expect", "levels": {"OUT1": 0}},
    {"at": 4300, "do": "request", "req": {"op": "run", "show": 1}, "ok": false},
    {"at": 8000, "do": "set", "input": "TRIG1", "active": true},
    {"at": 8200, "do": "expect", "levels": {"OUT1": 1000}},
    {"at": 14000, "do": "expect", "levels": {"OUT1": 0}},
    {"at": 14500, "do": "set", "input": "TRIG1", "active": false}
  ],
  "until": 15000
}
