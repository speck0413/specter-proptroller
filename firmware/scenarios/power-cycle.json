{
  "name": "Power loss mid-show; trigger held through the boot",
  "shows": [{
    "id": 1, "name": "Lamp", "triggers": [{"on": "input", "input": "TRIG1"}],
    "tracks": [{"target": "OUT4", "cues": [{"at": 0, "do": "pulse", "ms": 5000}]}]
  }],
  "steps": [
    {"at": 3000, "do": "set", "input": "TRIG1", "active": true},
    {"at": 3200, "do": "expect", "levels": {"OUT4": 1000}},
