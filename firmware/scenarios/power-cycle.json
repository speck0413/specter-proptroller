    {"at": 4400, "do": "expect", "levels": {"OUT4": 0}},
    {"at": 9000, "do": "expect", "levels": {"OUT4": 0}},
    {"at": 9100, "do": "set", "input": "TRIG1", "active": false},
    {"at": 9500, "do": "press", "input": "TRIG1", "ms": 150},
    {"at": 9700, "do": "expect", "levels": {"OUT4": 1000}}
  ],
  "until": 10000
}
